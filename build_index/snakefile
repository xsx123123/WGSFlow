#!/usr/bin/env python3
# *---utf-8---*

import sys
import os
from snakemake.utils import min_version, validate

# Lock Snakemake Version
min_version("9.9.0")

# --------- 1. Config Loading --------- #
# Load default configs
configfile: "config.yaml"

# get new refence path
new_genome_path = os.path.join(config["reference_path"],f"{config["genome_version_info"]["genome_name"]}")
new_genome_name = f"{config["genome_version_info"]["genome_name"]}"
# --------- 4. Rules Import --------- #
include: 'rules/building_index.smk'
# --------- 5. Target Rule --------- #
rule all:
    input:
        os.path.join(new_genome_path,new_genome_name,f"{new_genome_name}.bwa_index.amb"),
        os.path.join(new_genome_path,new_genome_name,f"{new_genome_name}.bwa_index.ann"),
        os.path.join(new_genome_path,new_genome_name,f"{new_genome_name}.bwa_index.bwt"),
        os.path.join(new_genome_path,new_genome_name,f"{new_genome_name}.bwa_index.pac"),
        os.path.join(new_genome_path,new_genome_name,f"{new_genome_name}.gtf"),
        os.path.join(new_genome_path,new_genome_name,f"{new_genome_name}.gff"),
        os.path.join(new_genome_path,new_genome_name,f"{new_genome_name}.go"),
        os.path.join(new_genome_path,new_genome_name,f"{new_genome_name}.gtf.bed12"),
        os.path.join(new_genome_path,new_genome_name,f"{new_genome_name}.all.txt"),